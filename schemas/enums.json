{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "bluetti-field-enum",
    "title": "Enums",
    "anyOf": [
        {
            "title": "Charging Mode",
            "type": "integer",
            "enum": [
                "standard",
                "silent",
                "turbo"
            ]
        },
        {
            "title": "Display Mode",
            "type": "integer",
            "enum": [
                0,
                1,
                "sec30",
                "min1",
                "min5",
                "never"
            ]
        },
        {
            "title": "Eco Mode",
            "type": "integer",
            "enum": [
                0,
                "hours1",
                "hours2",
                "hours3",
                "hours4"
            ]
        },
        {
            "title": "Frequency Mode",
            "type": "integer",
            "enum": [
                0,
                "h50",
                "h60"
            ]
        },
        {
            "title": "Led Mode",
            "type": "integer",
            "enum": [
                0,
                "low",
                "high",
                "sos",
                "off"
            ]
        },
        {
            "title": "Output Mode",
            "type": "integer",
            "enum": [
                "stop",
                "inverter_output",
                "bypass_output_c",
                "bypass_output_d",
                "load_matching"
            ]
        },
        {
            "title": "Split Phase Mode",
            "type": "integer",
            "enum": [
                "slave",
                "master"
            ]
        },
        {
            "title": "Ups Mode",
            "type": "integer",
            "enum": [
                0,
                "custom",
                "pv_priority",
                "standard",
                "time_control"
            ]
        }
    ]
}