{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Translation list",
    "properties": {
        "lang": {
            "type": "string",
            "title": "Language code"
        },
        "texts": {
            "type": "array",
            "title": "Translations",
            "items": {
                "$ref": "https://raw.githubusercontent.com/Patrick762/bluetti-registers/refs/heads/main/schemas/translation.json"
            }
        }
    },
    "required": [
        "lang",
        "texts"
    ]
}